<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_launch</name>
  <version>0.0.0</version>
  <description>Launch files bringing up the robot's RealSense cameras (world D455 + left/right D405 wrist cameras)</description>
  <maintainer email="selvambharani100@gmial.com">phy_ai</maintainer>
  <license>MIT</license>

  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
