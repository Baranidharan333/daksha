<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motor_configure</name>
  <version>0.0.1</version>
  <description>Motor configuration web UI.</description>
  <maintainer email="selvambharani100@gmail.com">baranidharan</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>

  <exec_depend>python3-can</exec_depend>
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>gen2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
