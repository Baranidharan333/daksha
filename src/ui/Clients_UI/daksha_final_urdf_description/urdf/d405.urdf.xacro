<link name="right_gripper_cam_color_frame"/>

<joint name="right_gripper_cam_color_joint" type="fixed">
    <parent link="right_gripper_cam_link"/>
    <child link="right_gripper_cam_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<!-- Color Optical Frame -->
<link name="right_gripper_cam_color_optical_frame"/>

<joint name="right_gripper_cam_color_optical_joint" type="fixed">
    <parent link="right_gripper_cam_color_frame"/>
    <child link="right_gripper_cam_color_optical_frame"/>
    <origin xyz="0 0 0"
            rpy="-1.57079632679 0 -1.57079632679"/>
