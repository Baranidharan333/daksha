<joint name="right_gripper_cam_infra1_joint" type="fixed">
    <parent link="right_gripper_cam_link"/>
    <child link="right_gripper_cam_infra1_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<!-- Infra1 Optical Frame -->
<link name="right_gripper_cam_infra1_optical_frame"/>

<joint name="right_gripper_cam_infra1_optical_joint" type="fixed">
    <parent link="right_gripper_cam_infra1_frame"/>
    <child link="right_gripper_cam_infra1_optical_frame"/>
    <origin xyz="0 0 0"
            rpy="-1.57079632679 0 -1.57079632679"/>
</joint>

<!-- Infra2 Frame -->
<link name="right_gripper_cam_infra2_frame"/>

<joint name="right_gripper_cam_infra2_joint" type="fixed">
    <parent link="right_gripper_cam_link"/>
    <child link="right_gripper_cam_infra2_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<!-- Infra2 Optical Frame -->
<link name="right_gripper_cam_infra2_optical_frame"/>

<joint name="right_gripper_cam_infra2_optical_joint" type="fixed">
    <parent link="right_gripper_cam_infra2_frame"/>
    <child link="right_gripper_cam_infra2_optical_frame"/>
    <origin xyz="0 0 0"
            rpy="-1.57079632679 0 -1.57079632679"/>
</joint>

</robot>
