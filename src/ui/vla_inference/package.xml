<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vla_inference</name>
  <version>0.0.1</version>
  <description>
    VLA inference command console (Flask): takes a natural-language task from
    the operator and publishes it for the vision-language-action engine to
    execute. Split out of daksha_ui, where it lived as subui_app.py.
  </description>
  <maintainer email="dev@ihub-robotics.org">iHub Robotics Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-flask</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
