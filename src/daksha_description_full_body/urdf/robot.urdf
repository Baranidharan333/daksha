    <!-- ros2_control block -->
  <ros2_control name="RightArmSystem" type="system">
    <hardware>
      <plugin>arm_hardware/ArmHardwareInterface</plugin>

      <!-- YOUR PARAMETERS -->
      <param name="can_interface">vcan0</param>
      <param name="motor_ids">1,2,3,4,5,6,7,8</param>
      <param name="kp">0.05,0.05,0.05,0.05,0.05,0.05,0.05,0.05</param>
      <param name="kd">0.01,0.01,0.01,0.01,0.01,0.01,0.01,0.01</param>
      <param name="direction">1,1,-1,-1,-1,1,1,-1</param>
      <param name="control_modes">mit,mit,mit,mit,mit,mit,mit,mit</param>

    </hardware>
    <!-- right_shoulder_pitch -->
    <joint name="right_joint_1">
      <param name="type">revolute</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- right_shoulder_roll -->
    <joint name="right_joint_2">
      <param name="type">revolute</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- right_elbow_yaw -->
    <joint name="right_joint_3">
      <param name="type">revolute</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>


    <!-- right_elbow_pitch -->
    <joint name="right_joint_4">
      <param name="type">revolute</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- right_wrist_roll -->
    <joint name="right_joint_5">
      <param name="type">revolute</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- right_wrist_yaw -->
    <joint name="right_joint_6">
      <param name="type">revolute</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- right_wrist_pitch -->
    <joint name="right_joint_7">
      <param name="type">revolute</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- right_gripper (actuated finger) -->
    <joint name="right_gripper_right_joint">
      <param name="type">prismatic</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>



</ros2_control>


