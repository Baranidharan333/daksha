  <!-- GRIPPER JOINTS -->
  <joint name="right_gripper_base_joint" type="fixed">
    <origin xyz="-0.000938 0.0 -0.095364" rpy="0 0 0"/>
    <parent link="right_link_8"/>
    <child link="right_gripper_mount"/>
  </joint>

  <joint name="right_right_finger_joint" type="prismatic">
    <origin xyz="0 -0.064 -0.02" rpy="0 0 0"/>
    <parent link="right_gripper_mount"/>
    <child link="right_right_finger"/>
    <axis xyz="0.022481 0.999621 -0.015888"/>
    <limit upper="0.044" lower="0.0" effort="100" velocity="100"/>
  </joint>

  <joint name="right_left_finger_joint" type="prismatic">
    <origin xyz="0 0.064 -0.02" rpy="0 0 0"/>
