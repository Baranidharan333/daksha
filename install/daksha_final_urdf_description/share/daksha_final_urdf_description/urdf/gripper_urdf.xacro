    <child link="right_left_finger"/>
    <axis xyz="-0.022481 -0.999621 0.015888"/>
    <limit upper="0.044" lower="0.0" effort="100" velocity="100"/>
    <mimic joint="right_right_finger_joint" multiplier="1.0" offset="0.0"/>
