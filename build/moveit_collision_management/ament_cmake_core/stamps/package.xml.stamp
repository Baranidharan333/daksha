<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moveit_collision_management</name>
  <version>0.0.1</version>
  <description>Self-collision monitoring for daksha using MoveIt2's own collision pipeline (moveit_core/collision_detection_fcl) instead of placo</description>
  <maintainer email="selvambharani100@gmail.com">baranidharan</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>urdf</depend>
  <depend>srdfdom</depend>
  <depend>moveit_core</depend>
  <depend>collision_management</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>daksha_description_full_body</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
