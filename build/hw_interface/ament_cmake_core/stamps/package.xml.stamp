<?xml version="1.0"?>
<package format="3">

  <name>hw_interface</name>

  <version>0.0.0</version>

  <description>
    Damiao ROS2 hardware interface
  </description>

  <maintainer email="user@todo.todo">
    user
  </maintainer>

  <license>Apache-2.0</license>

  <!-- Build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- ros2_control -->
  <depend>hardware_interface</depend>

  <!-- Pluginlib -->
  <depend>pluginlib</depend>

  <!-- Services -->
  <depend>std_srvs</depend>

  <!-- Messages -->
  <depend>std_msgs</depend>

  <!-- vcan_bridge_node: CANalyst-II USB-CAN adapter driver -->
  <depend>libusb-1.0-0-dev</depend>

  <!-- Message generation -->
  <build_depend>rosidl_default_generators</build_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Interface packages -->
  <member_of_group>
    rosidl_interface_packages
  </member_of_group>

  <export>
    <build_type>ament_cmake</build_type>

    <hardware_interface plugin="${prefix}/my_robot_hardware_interface.xml"/>

  </export>

</package>
